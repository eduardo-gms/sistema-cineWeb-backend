# ========================================================
# CineWeb Backend — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# ========================================================

# URL de conexão ao PostgreSQL
DATABASE_URL=postgresql://postgres:60451@localhost:5432/cineweb?schema=public

# Chave secreta para assinar Access Tokens JWT (15min)
# Em produção, use uma chave longa e aleatória!
JWT_SECRET=cineweb-jwt-secret-dev-2026

# Chave secreta para assinar Refresh Tokens JWT (7 dias)
JWT_REFRESH_SECRET=cineweb-jwt-refresh-secret-dev-2026

# Porta do servidor
PORT=3000
