// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Genero {
  id     String  @id @default(uuid())
  nome   String  @unique
  filmes Filme[]
}

model Filme {
  id                  String   @id @default(uuid())
  titulo              String
  duracao             Int // em minutos
  sinopse             String
  elenco              String
  generoId            String
  classificacaoEtaria String
  dataInicioExibicao  DateTime
  dataFimExibicao     DateTime
  status              String
  genero              Genero   @relation(fields: [generoId], references: [id])
  sessoes             Sessao[]
}

model Sala {
  id         String   @id @default(uuid())
  numero     Int      @unique
  capacidade Int
  sessoes    Sessao[]
}

model Sessao {
  id            String     @id @default(uuid())
  filmeId       String
  salaId        String
  data          DateTime
  horario       String
  valorIngresso Float
  filme         Filme      @relation(fields: [filmeId], references: [id])
  sala          Sala       @relation(fields: [salaId], references: [id])
  ingressos     Ingresso[]
}

model LancheCombo {
  id            String             @id @default(uuid())
  nome          String
  descricao     String
  valorUnitario Float
  estoque       Int
  pedidos       ItemPedidoLanche[]
}

model Pedido {
  id         String             @id @default(uuid())
  valorTotal Float
  qtdInteira Int
  qtdMeia    Int
  dataHora   DateTime           @default(now())
  ingressos  Ingresso[]
  lanches    ItemPedidoLanche[]
}

model ItemPedidoLanche {
  id            String      @id @default(uuid())
  pedidoId      String
  lancheComboId String
  quantidade    Int
  precoUnitario Float
  pedido        Pedido      @relation(fields: [pedidoId], references: [id])
  lancheCombo   LancheCombo @relation(fields: [lancheComboId], references: [id])
}

model Ingresso {
  id        String @id @default(uuid())
  pedidoId  String
  sessaoId  String
  poltrona  String
  tipo      String
  valorPago Float
  pedido    Pedido @relation(fields: [pedidoId], references: [id])
  sessao    Sessao @relation(fields: [sessaoId], references: [id])
}
